# PeachBitch — environment (copy to .env)

# Database
DATABASE_URL="file:./dev.db"

# Web auth
AUTH_SECRET="change-me-in-production"

# Telegram bot (@peachbibot) — NEVER commit real token
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_PUBLIC_URL="https://t.me/peachbibot"
TELEGRAM_MINIAPP_URL="http://localhost:3000/tg/templates"
TELEGRAM_WEBHOOK_SECRET=""

# Dev: send this phrase in bot chat to reset onboarding (change in production)
TG_DEV_RESET_CODE="PB_RESET_7"

# Bot GIFs / photos (Telegram file_id or URL). Bundled defaults in public/tg/media/
# TG_VIDEO_START=       → onboard-1.mp4 (старт)
# TG_VIDEO_WELCOME=     → onboard-2.mp4 (welcome)
# TG_GIF_PHOTO_UPLOAD=  → onboard-3.jpg (загрузка фото)
# TG_GIF_TOPUP=         → topup.jpg (пополнение)
# Legacy: TG_GIF_START / TG_GIF_WELCOME also work as file_id override

# Help screen
# TG_SUPPORT_CONTACT=@peachbitch_support
# TG_RESERVE_LINKS=t.me/peachbitch_bot | peachbitch.com

# Inline template picker in bot (comma-separated ids; empty = all published)
# TG_BOT_INLINE_TEMPLATE_IDS=

# FX for checkout display (1 peach = 1 RUB)
# TELEGRAM_RULES_ARTICLE_URL_RU=https://telegra.ph/...
# TELEGRAM_RULES_ARTICLE_URL_EN=https://telegra.ph/...
TG_RUB_PER_USDT=80
TG_STARS_PER_PEACH=0.77

# Payment provider (crypto + SBP) — TBD
# PAYMENT_API_URL=
# PAYMENT_API_KEY=

# Comfy / GPU (optional for TG skeleton)
PEACH_USE_COMFY=0
COMFY_FORCE_MOCK=1
